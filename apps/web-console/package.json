  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.1.0",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.11",
    "jsdom": "27.0.1",
    "typescript": "5.9.3",
    "vitest": "4.0.4"
  }
}
